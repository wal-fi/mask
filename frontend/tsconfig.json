{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "/admin/ui/assets/ui.js": [
        "../src/maskgw/admin/ui/assets/ui.js"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "private/**/*.d.ts",
    "test/**/*.js",
    "tools/**/*.js",
    "browser/**/*.js",
    "browser/**/*.d.ts",
    "playwright.config.js"
  ]
}

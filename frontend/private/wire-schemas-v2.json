  "PolicySqlBody": {
    "additionalProperties": false,
    "description": "`denied_functions` obrigatorio: `sql: {}` nao apaga negacoes em silencio.\n\n`allowed_pg_functions` e declarado so para que sua PRESENCA — inclusive\n`null` ou `[]` — vire `IMMUTABLE_FIELD`; ausente, o valor corrente e\npreservado (D-050).",
    "properties": {
      "allowed_pg_functions": {
        "anyOf": [
          {
            "$ref": "#/$defs/JsonValue"
          },
          {
            "type": "null"
          }
        ],
        "default": null

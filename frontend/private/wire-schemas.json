      }
    },
    "title": "ConfigValidateRequest",
    "type": "object"
  },
  "ConfigValidateResponse": {
    "additionalProperties": false,
    "description": "Resposta de sucesso de `config:validate`. Quatro booleanos, e nada mais.\n\nSem `revision`, sem `applied`, sem conteudo normalizado, sem secret, sem\ndetalhe de transformer e sem representacao do objeto compilado: a operacao\nnao le estado nem publica nada, entao a resposta nao carrega identidade de\nconfiguracao alguma (D-058).\n\n`database_checks_performed` e sempre `false` nesta fase: `config:validate`\nNAO conecta ao PostgreSQL. Conectar tem custo e efeito no servidor, e a\nverificacao de conexao pertence ao fluxo real de escrita, onde ha um\ncandidato a publicar (secao 1.2). A resposta diz isso na propria forma, em\nvez de omitir e deixar o chamador supor.",
    "properties": {
      "database_checks_performed": {
        "title": "Database Checks Performed",
        "type": "boolean"
      },
      "policy_compiled": {
        "title": "Policy Compiled",
        "type": "boolean"
      },
      "schema_validated": {
        "title": "Schema Validated",
        "type": "boolean"
      },
      "valid": {
        "title": "Valid",
        "type": "boolean"
      }
    },
    "required": [
      "valid",
      "schema_validated",
      "policy_compiled",
      "database_checks_performed"
    ],
    "title": "ConfigValidateResponse",
    "type": "object"
  },

        },
        "title": "Denied Relations",
        "type": "array"
      },
      "editable": {
        "title": "Editable",
        "type": "boolean"
      },
      "pg_namespace_default": {
        "title": "Pg Namespace Default",
        "type": "string"
      },
      "pipeline": {
        "items": {
          "type": "string"
        },
        "title": "Pipeline",
        "type": "array"
      },
      "revision": {
        "title": "Revision",
        "type": "integer"
      },
      "session": {
        "$ref": "#/$defs/ProtectedSession"
      },
      "unmatched_policy": {
        "title": "Unmatched Policy",
        "type": "string"
      },
      "validator_rules": {
        "items": {
          "type": "string"
        },
        "title": "Validator Rules",
        "type": "array"
      }
    },
    "required": [
